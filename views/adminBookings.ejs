<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Customer Bookings</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container py-5">
    <h1 class="h2 mb-4">Customer Bookings</h1>

    <%
      let total = 0, approvedTotal = 0, pendingCount = 0, approvedCount = 0, declinedCount = 0, cancelledCount = 0;
      for (let i = 0; i < bookings.length; i++) {
        const st = bookings[i].payment_status;
        if (st === 'approved') { approvedCount++; approvedTotal += Number(bookings[i].booked_price); }
        else if (st === 'pending') pendingCount++;
        else if (st === 'declined') declinedCount++;
        else if (st === 'cancelled') cancelledCount++;
      }
    %>
    <div class="row g-3 mb-4">
      <div class="col-6 col-md-3"><div class="card p-3"><div class="text-secondary small">Bookings</div><div class="h4 mb-0"><%= bookings.length %></div></div></div>
      <div class="col-6 col-md-3"><div class="card p-3"><div class="text-secondary small">Approved (simulated)</div><div class="h4 mb-0"><%= approvedCount %> &middot; S$<%= approvedTotal.toFixed(2) %></div></div></div>
      <div class="col-6 col-md-3"><div class="card p-3"><div class="text-secondary small">Pending / Declined</div><div class="h4 mb-0"><%= pendingCount %> / <%= declinedCount %></div></div></div>
      <div class="col-6 col-md-3"><div class="card p-3"><div class="text-secondary small">Cancelled</div><div class="h4 mb-0"><%= cancelledCount %></div></div></div>
    </div>
    <p class="text-secondary small">All amounts are simulated. No real money is collected.</p>

    <div class="pc-search mb-3">
      <input type="search" id="filterText" class="form-control" placeholder="Search owner, pet or service..." aria-label="Search bookings">
      <select id="filterStatus" class="form-select" style="max-width: 200px;" aria-label="Filter by payment status">
        <option value="">All payments</option>
        <option value="pending">Pending</option>
        <option value="approved">Approved</option>
        <option value="declined">Declined</option>
        <option value="cancelled">Cancelled</option>
      </select>
    </div>

    <% if (!bookings.length) { %>
      <div class="alert alert-info">No bookings yet.</div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">Date</th>
              <th scope="col">Owner</th>
              <th scope="col">Pet</th>
              <th scope="col">Service</th>
              <th scope="col">Price</th>
              <th scope="col">Booking</th>
              <th scope="col">Payment</th>
              <th scope="col">Reference</th>
            </tr>
          </thead>
          <tbody>
            <% for (let i = 0; i < bookings.length; i++) { %>
              <tr data-pay="<%= bookings[i].payment_status || '' %>">
                <td><%= bookings[i].booking_id %></td>
                <td><%= bookings[i].booking_date %></td>
                <td><%= bookings[i].owner_name %></td>
                <td><%= bookings[i].pet_name %></td>
                <td><%= bookings[i].service_name %></td>
                <td>S$<%= Number(bookings[i].booked_price).toFixed(2) %></td>
                <td><span class="badge status-<%= String(bookings[i].booking_status).toLowerCase() %>"><%= bookings[i].booking_status %></span></td>
                <td>
                  <% if (bookings[i].payment_status) { %>
                    <span class="badge status-<%= String(bookings[i].payment_status).toLowerCase() %>"><%= bookings[i].payment_status %></span>
                  <% } else { %>
                    <span class="text-secondary">none</span>
                  <% } %>
                </td>
                <td><code><%= bookings[i].payment_reference || '-' %></code></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Simple filter in the browser: shows or hides rows, nothing is sent to the server
    (function () {
      var text = document.getElementById('filterText');
      var status = document.getElementById('filterStatus');
      var rows = document.querySelectorAll('tbody tr');
      function apply() {
        var q = text.value.trim().toLowerCase();
        var st = status.value;
        rows.forEach(function (row) {
          var okText = !q || row.textContent.toLowerCase().indexOf(q) !== -1;
          var okStatus = !st || row.getAttribute('data-pay') === st;
          row.style.display = (okText && okStatus) ? '' : 'none';
        });
      }
      text.addEventListener('input', apply);
      status.addEventListener('change', apply);
    })();
  </script>
  <%- include('partials/footer') %>
</body>
</html>
