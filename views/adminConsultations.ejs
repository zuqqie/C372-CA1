<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Consultation Inbox</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container py-5">
    <h1 class="h2 mb-4">Consultation Inbox</h1>

    <% if (messages && messages.length) { %>
      <% for (let i = 0; i < messages.length; i++) { %>
        <div class="alert alert-success" role="status"><%= messages[i] %></div>
      <% } %>
    <% } %>
    <% if (errors && errors.length) { %>
      <% for (let i = 0; i < errors.length; i++) { %>
        <div class="alert alert-danger" role="alert"><%= errors[i] %></div>
      <% } %>
    <% } %>

    <% if (!consultations.length) { %>
      <div class="alert alert-info">No consultation requests yet.</div>
    <% } else { %>
      <div class="row g-3">
        <% for (let i = 0; i < consultations.length; i++) { %>
          <% const c = consultations[i]; %>
          <div class="col-12">
            <div class="card p-3">
              <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                <div>
                  <h2 class="h5 mb-1"><%= c.pet_name %> <span class="text-secondary fs-6">(<%= c.species %>, <%= c.breed %>, <%= c.age %> yrs)</span></h2>
                  <span class="text-secondary">Owner: <%= c.owner_name %> &middot; <%= c.concern_type %></span>
                </div>
                <div class="d-flex gap-2">
                  <span class="badge urgency-<%= c.urgency %>">Urgency: <%= c.urgency %></span>
                  <span class="badge status-<%= c.status %>"><%= c.status %></span>
                </div>
              </div>
              <p class="mb-3" style="white-space: pre-line;"><%= c.symptoms %></p>

              <% if (c.status === 'open') { %>
                <form action="/admin/consultations/<%= c.id %>/reply" method="POST">
                  <label for="reply-<%= c.id %>" class="form-label">Your reply</label>
                  <textarea id="reply-<%= c.id %>" name="reply" class="form-control mb-2" rows="3"
                    minlength="5" maxlength="1000" required></textarea>
                  <button type="submit" class="btn btn-primary btn-sm">Send reply</button>
                </form>
              <% } else { %>
                <div class="alert alert-success mb-0">
                  <strong>Your reply:</strong>
                  <span style="white-space: pre-line;"><%= c.vet_reply %></span>
                </div>
              <% } %>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>
  </main>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
