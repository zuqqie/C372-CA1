<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin Dashboard</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container py-4 py-md-5">
    <div class="pc-hero text-start mb-4" style="padding: 2rem 1.75rem;">
      <h1 class="h2 mb-1">Welcome back, <%= session.user.name %></h1>
      <p class="text-secondary mb-0">Here is what is happening in Pet Care Journal today.</p>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-6 col-lg-3"><div class="pc-tile"><div class="pc-tile-num"><%= stats.customers %></div><div class="pc-tile-label">Customers</div></div></div>
      <div class="col-6 col-lg-3"><div class="pc-tile"><div class="pc-tile-num"><%= stats.pets %></div><div class="pc-tile-label">Pets registered</div></div></div>
      <div class="col-6 col-lg-3"><div class="pc-tile"><div class="pc-tile-num"><%= stats.bookings %></div><div class="pc-tile-label">Bookings</div></div></div>
      <div class="col-6 col-lg-3"><div class="pc-tile"><div class="pc-tile-num">S$<%= Number(stats.approved_total).toFixed(2) %></div><div class="pc-tile-label">Approved payments (simulated)</div></div></div>
    </div>

    <div class="row g-3">
      <div class="col-md-4">
        <div class="pc-feature">
          <h2>Customer bookings</h2>
          <p class="mb-3"><%= stats.pending_payments %> payment<%= Number(stats.pending_payments) === 1 ? '' : 's' %> still pending.</p>
          <a href="/admin/bookings" class="btn btn-primary btn-sm">View bookings</a>
        </div>
      </div>
      <div class="col-md-4">
        <div class="pc-feature">
          <h2>Consultation inbox</h2>
          <p class="mb-3"><%= stats.open_consultations %> request<%= Number(stats.open_consultations) === 1 ? '' : 's' %> waiting for a reply.</p>
          <a href="/admin/consultations" class="btn btn-primary btn-sm">Open inbox</a>
        </div>
      </div>
      <div class="col-md-4">
        <div class="pc-feature">
          <h2>Customers</h2>
          <p class="mb-3">See customers and their pets.</p>
          <a href="/admin/users" class="btn btn-primary btn-sm">View customers</a>
        </div>
      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <%- include('partials/footer') %>
</body>
</html>
