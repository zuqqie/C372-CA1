<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pay for Booking</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container py-5" style="max-width: 720px;">
    <h1 class="h2 mb-3">Pay for Booking #<%= booking.booking_id %></h1>

    <% if (messages && messages.length) { %>
      <% for (let i = 0; i < messages.length; i++) { %>
        <div class="alert alert-success" role="status"><%= messages[i] %></div>
      <% } %>
    <% } %>
    <% if (errors && errors.length) { %>
      <% for (let i = 0; i < errors.length; i++) { %>
        <div class="alert alert-danger" role="alert"><%= errors[i] %></div>
      <% } %>
    <% } %>

    <div class="alert alert-warning" role="note">
      <strong>Simulation only.</strong> No card details are asked for and no real money is taken.
      Pick the result you want to test.
    </div>

    <div class="card mb-4">
      <div class="card-body">
        <dl class="row mb-0">
          <dt class="col-sm-4">Pet</dt><dd class="col-sm-8"><%= booking.pet_name %></dd>
          <dt class="col-sm-4">Service</dt><dd class="col-sm-8"><%= booking.service_name %></dd>
          <dt class="col-sm-4">Booking date</dt><dd class="col-sm-8"><%= booking.booking_date %></dd>
          <dt class="col-sm-4">Amount to pay</dt><dd class="col-sm-8"><strong>S$<%= Number(booking.amount).toFixed(2) %></strong></dd>
          <dt class="col-sm-4">Payment status</dt>
          <dd class="col-sm-8"><span class="badge status-<%= booking.payment_status %>"><%= booking.payment_status %></span></dd>
        </dl>
      </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
      <form method="POST" action="/checkout/<%= booking.booking_id %>">
        <input type="hidden" name="testStatus" value="APPROVED">
        <button type="submit" class="btn btn-primary">Simulate approved payment</button>
      </form>
      <form method="POST" action="/checkout/<%= booking.booking_id %>">
        <input type="hidden" name="testStatus" value="DECLINED">
        <button type="submit" class="btn btn-outline-danger">Simulate declined payment</button>
      </form>
      <a href="/bookings" class="btn btn-outline-secondary">Back to bookings</a>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <%- include('partials/footer') %>
</body>
</html>
