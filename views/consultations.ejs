<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>My Consultations</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
      <h1 class="h2 mb-0">Pet Consultations</h1>
      <a href="/consultations/new" class="btn btn-primary">Ask a Vet</a>
    </div>

    <% if (messages && messages.length) { %>
      <% for (let i = 0; i < messages.length; i++) { %>
        <div class="alert alert-success" role="status"><%= messages[i] %></div>
      <% } %>
    <% } %>
    <% if (errors && errors.length) { %>
      <% for (let i = 0; i < errors.length; i++) { %>
        <div class="alert alert-danger" role="alert"><%= errors[i] %></div>
      <% } %>
    <% } %>

    <% if (!consultations.length) { %>
      <div class="alert alert-info">
        You have not asked a vet anything yet. Is your pet eating less, scratching a lot or acting strange? Send a consultation request.
      </div>
    <% } else { %>
      <div class="row g-3">
        <% for (let i = 0; i < consultations.length; i++) { %>
          <% const c = consultations[i]; %>
          <div class="col-12">
            <div class="card p-3">
              <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-2">
                <div>
                  <h2 class="h5 mb-1"><%= c.pet_name %> <span class="text-secondary fs-6">(<%= c.species %>)</span></h2>
                  <span class="text-secondary"><%= c.concern_type %></span>
                </div>
                <div class="d-flex gap-2">
                  <span class="badge urgency-<%= c.urgency %>">Urgency: <%= c.urgency %></span>
                  <span class="badge status-<%= c.status %>"><%= c.status %></span>
                </div>
              </div>
              <p class="mb-2" style="white-space: pre-line;"><%= c.symptoms %></p>
              <% if (c.vet_reply) { %>
                <div class="alert alert-success mb-0">
                  <strong>Vet reply:</strong>
                  <span style="white-space: pre-line;"><%= c.vet_reply %></span>
                </div>
              <% } else { %>
                <div class="text-secondary">Waiting for a vet to reply.</div>
              <% } %>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>
  </main>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
