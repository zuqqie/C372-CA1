<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Pet</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container mt-5">
    <h2 class="mb-4">Edit Pet</h2>
    <form action="/pets/edit/<%= pet.id %>" method="POST" enctype="multipart/form-data">
      <div class="mb-3">
        <label class="form-label">Pet Name:</label>
        <input type="text" class="form-control" name="pet_name" value="<%= pet.name %>" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Species:</label>
        <input type="text" class="form-control" name="species" value="<%= pet.species %>" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Breed:</label>
        <input type="text" class="form-control" name="breed" value="<%= pet.breed %>" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Age:</label>
        <input type="number" class="form-control" name="age" min="0" value="<%= pet.age %>" required>
      </div>

      <div class="mb-3">
        <label class="form-label">Change Pet Image (optional):</label>
        <% if (pet.image) { %>
          <div class="mb-2">
            <img src="/images/<%= pet.image %>" alt="Current photo of <%= pet.name %>"
                 class="img-thumbnail" style="width: 120px; height: 120px; object-fit: cover;">
          </div>
        <% } %>
        <input type="file" class="form-control" name="pet_image" accept="image/*">
        <div class="form-text">Leave empty to keep the current photo.</div>
      </div>

      <button type="submit" class="btn btn-success">Save Changes</button>
      <a href="/journals?petId=<%= pet.id %>" class="btn btn-outline-secondary">Cancel</a>
    </form>
  </div>
  <%- include('partials/footer') %>
</body>
</html>
