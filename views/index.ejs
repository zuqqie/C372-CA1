<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Pet Care Journal System</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  
    <%- include ('partials/navbar') %>

  <div class="container mt-5">
    <div class="pc-hero text-center">
      <h1>Welcome to the Pet Care Journal</h1>
      <p class="lead">Track your pets' activities and health, book services and keep everything in one calm place.</p>
      <% if (!session || !session.user) { %>
        <a href="/signup" class="btn btn-primary btn-lg me-2">Get Started</a>
        <a href="/login" class="btn btn-outline-secondary btn-lg">Log in</a>
      <% } else if (session.user.role === 'admin') { %>
        <a href="/admin/dashboard" class="btn btn-primary btn-lg me-2">Admin Dashboard</a>
        <a href="/admin/bookings" class="btn btn-outline-secondary btn-lg">Customer Bookings</a>
      <% } else { %>
        <a href="/journals" class="btn btn-primary btn-lg me-2">View My Journals</a>
        <a href="/services" class="btn btn-outline-secondary btn-lg">Book a Service</a>
      <% } %>
    </div>

    <div class="row g-3 pc-features">
      <div class="col-md-4">
        <div class="pc-feature">
          <h2>Pet journals</h2>
          <p>Write down walks, meals and vet visits so nothing is forgotten.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="pc-feature">
          <h2>Book services</h2>
          <p>Choose vaccination, grooming or boarding. Payments stay pending in this demo.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="pc-feature">
          <h2>Your pets only</h2>
          <p>You can only see and change your own pets and entries.</p>
        </div>
      </div>
    </div>
  </div>
  <%- include('partials/footer') %>
</body>
</html>
