<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pet Journals</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <%
    // Small helpers for the page
    const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
    function iconFor(text) {
      const t = String(text || '').toLowerCase();
      if (/walk|run|jog/.test(t)) return '\u{1F9AE}';
      if (/meal|food|feed|eat|treat|water|dinner|lunch|breakfast|snack/.test(t)) return '\u{1F356}';
      if (/vet|check|vaccin|clinic|doctor/.test(t)) return '\u{1FA7A}';
      if (/groom|bath|brush|nail|trim/.test(t)) return '\u{1F6C1}';
      if (/play|toy|ball|game|train/.test(t)) return '\u{1F3BE}';
      if (/medic|pill|tablet|drug/.test(t)) return '\u{1F48A}';
      if (/sleep|nap|rest/.test(t)) return '\u{1F634}';
      return '\u{1F43E}';
    }
    const searching = (typeof searchTerm !== 'undefined' && searchTerm);
    const dates = journals.map(j => String(j.entry_date || '').slice(0, 10)).filter(Boolean).sort();
    const latest = dates.length ? dates[dates.length - 1] : null;
    const thisMonth = new Date().getFullYear() + '-' + String(new Date().getMonth() + 1).padStart(2, '0');
    const monthCount = dates.filter(d => d.slice(0, 7) === thisMonth).length;
  %>

  <main class="container py-4 py-md-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
      <div>
        <h1 class="h2 mb-1">Pet Care Journal</h1>
        <p class="text-secondary mb-0">A little diary for every day with your pet.</p>
      </div>
      <div class="d-flex gap-2">
        <a href="/journals/new<%= selectedPetId ? '?petId=' + selectedPetId : '' %>" class="btn btn-primary">+ New entry</a>
        <a href="/pets/new" class="btn btn-outline-secondary">+ Add pet</a>
      </div>
    </div>

    <% if (typeof messages !== 'undefined' && messages.length) { %>
      <% for (let i = 0; i < messages.length; i++) { %>
        <div class="alert alert-success" role="status"><%= messages[i] %></div>
      <% } %>
    <% } %>
    <% if (typeof errors !== 'undefined' && errors.length) { %>
      <% for (let i = 0; i < errors.length; i++) { %>
        <div class="alert alert-danger" role="alert"><%= errors[i] %></div>
      <% } %>
    <% } %>

    <% if (pets && pets.length > 1) { %>
      <div class="pc-pills mb-4">
        <% for (let i = 0; i < pets.length; i++) { %>
          <a href="/journals?petId=<%= pets[i].id %>"
             class="pc-pill <%= String(selectedPetId) === String(pets[i].id) ? 'active' : '' %>">
            <span class="pc-pill-dot"><%= String(pets[i].name).charAt(0).toUpperCase() %></span>
            <%= pets[i].name %>
          </a>
        <% } %>
      </div>
    <% } %>

    <% if (pet && pet.name) { %>
      <section class="pc-pet-card mb-4">
        <% if (pet.image) { %>
          <img src="/images/<%= pet.image %>" alt="Photo of <%= pet.name %>" class="pc-pet-photo">
        <% } else { %>
          <div class="pc-pet-photo pc-pet-photo-empty"><%= String(pet.name).charAt(0).toUpperCase() %></div>
        <% } %>

        <div class="flex-grow-1">
          <h2 class="h3 mb-2"><%= pet.name %></h2>
          <div class="d-flex flex-wrap gap-2 mb-3">
            <span class="pc-chip"><%= pet.species %></span>
            <span class="pc-chip"><%= pet.breed %></span>
            <span class="pc-chip"><%= pet.age %> <%= Number(pet.age) === 1 ? 'year' : 'years' %> old</span>
          </div>
          <div class="d-flex flex-wrap gap-2">
            <a href="/pets/edit/<%= pet.id %>" class="btn btn-sm btn-warning">Edit pet</a>
            <a href="/consultations/new?petId=<%= pet.id %>" class="btn btn-sm btn-outline-secondary">Ask a vet</a>
            <a href="/services?petId=<%= pet.id %>" class="btn btn-sm btn-outline-secondary">Book a service</a>
            <form action="/pets/delete/<%= pet.id %>" method="POST" class="m-0"
                  onsubmit="return confirm('Delete <%= pet.name %> with all of its journal entries and consultations?');">
              <button type="submit" class="btn btn-sm btn-outline-danger">Delete pet</button>
            </form>
          </div>
        </div>

        <div class="pc-stats">
          <div class="pc-stat"><div class="pc-stat-num"><%= journals.length %></div><div class="pc-stat-label">Entries</div></div>
          <div class="pc-stat"><div class="pc-stat-num"><%= monthCount %></div><div class="pc-stat-label">This month</div></div>
          <div class="pc-stat"><div class="pc-stat-num pc-stat-small"><%= latest ? (Number(latest.slice(8, 10)) + ' ' + MONTHS[Number(latest.slice(5, 7)) - 1]) : '-' %></div><div class="pc-stat-label">Latest</div></div>
        </div>
      </section>
    <% } %>

    <form action="/journals/search" method="GET" class="pc-search mb-4">
      <input type="text" name="q" class="form-control" placeholder="Search activity or notes..." value="<%= searching ? searchTerm : '' %>" required>
      <% if (selectedPetId) { %><input type="hidden" name="petId" value="<%= selectedPetId %>"><% } %>
      <button type="submit" class="btn btn-primary">Search</button>
      <% if (searching) { %>
        <a href="/journals<%= selectedPetId ? '?petId=' + selectedPetId : '' %>" class="btn btn-outline-secondary">Clear</a>
      <% } %>
    </form>

    <% if (searching) { %>
      <p class="text-secondary">Showing <%= journals.length %> result<%= journals.length === 1 ? '' : 's' %> for &ldquo;<%= searchTerm %>&rdquo;</p>
    <% } %>

    <% if (!pets || pets.length === 0) { %>
      <div class="pc-empty">
        <div class="pc-empty-icon">&#128062;</div>
        <h2 class="h4">No pets yet</h2>
        <p class="text-secondary">Add your first pet to start a journal.</p>
        <a href="/pets/new" class="btn btn-primary">+ Add pet</a>
      </div>
    <% } else if (journals.length === 0) { %>
      <div class="pc-empty">
        <div class="pc-empty-icon">&#128214;</div>
        <h2 class="h4"><%= searching ? 'No matching entries' : 'No entries yet' %></h2>
        <p class="text-secondary"><%= searching ? 'Try a different word.' : 'Write down a walk, a meal or a vet visit.' %></p>
        <% if (!searching) { %><a href="/journals/new<%= selectedPetId ? '?petId=' + selectedPetId : '' %>" class="btn btn-primary">+ New entry</a><% } %>
      </div>
    <% } else { %>
      <div class="pc-timeline">
        <% for (let i = 0; i < journals.length; i++) { %>
          <% const d = String(journals[i].entry_date || '').slice(0, 10); %>
          <article class="pc-entry">
            <div class="pc-date">
              <% if (d) { %>
                <span class="pc-date-day"><%= Number(d.slice(8, 10)) %></span>
                <span class="pc-date-month"><%= MONTHS[Number(d.slice(5, 7)) - 1] %></span>
                <span class="pc-date-year"><%= d.slice(0, 4) %></span>
              <% } else { %>
                <span class="pc-date-month">N/A</span>
              <% } %>
            </div>
            <div class="pc-entry-body">
              <h3 class="h5 mb-1"><span class="pc-entry-icon"><%= iconFor(journals[i].activity) %></span> <%= journals[i].activity %></h3>
              <p class="mb-2 text-secondary" style="white-space: pre-line;"><%= journals[i].notes || 'No notes.' %></p>
              <div class="d-flex gap-2">
                <a href="/journals/edit/<%= journals[i].id %>" class="btn btn-sm btn-warning">Edit</a>
                <form action="/journals/delete/<%= journals[i].id %>" method="POST" class="m-0"
                      onsubmit="return confirm('Are you sure you want to delete this entry?');">
                  <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
              </div>
            </div>
          </article>
        <% } %>
      </div>
    <% } %>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <%- include('partials/footer') %>
</body>
</html>
