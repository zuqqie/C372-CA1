<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Payment Confirmation</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container py-5" style="max-width: 720px;">
    <h1 class="h2 mb-3">Payment Confirmation</h1>

    <% if (messages && messages.length) { %>
      <% for (let i = 0; i < messages.length; i++) { %>
        <div class="alert alert-success" role="status"><%= messages[i] %></div>
      <% } %>
    <% } %>
    <% if (errors && errors.length) { %>
      <% for (let i = 0; i < errors.length; i++) { %>
        <div class="alert alert-danger" role="alert"><%= errors[i] %></div>
      <% } %>
    <% } %>

    <% if (booking.payment_status === 'pending') { %>
      <div class="alert alert-info">This booking has not been paid yet.</div>
    <% } %>

    <div class="card mb-4">
      <div class="card-body">
        <p class="text-secondary small mb-3">Simulated payment. No real money was taken.</p>
        <dl class="row mb-0">
          <dt class="col-sm-4">Booking #</dt><dd class="col-sm-8"><%= booking.booking_id %></dd>
          <dt class="col-sm-4">Pet</dt><dd class="col-sm-8"><%= booking.pet_name %></dd>
          <dt class="col-sm-4">Service</dt><dd class="col-sm-8"><%= booking.service_name %></dd>
          <dt class="col-sm-4">Booking date</dt><dd class="col-sm-8"><%= booking.booking_date %></dd>
          <dt class="col-sm-4">Amount</dt><dd class="col-sm-8">S$<%= Number(booking.amount).toFixed(2) %></dd>
          <dt class="col-sm-4">Booking status</dt>
          <dd class="col-sm-8"><span class="badge status-<%= booking.booking_status %>"><%= booking.booking_status %></span></dd>
          <dt class="col-sm-4">Payment status</dt>
          <dd class="col-sm-8"><span class="badge status-<%= booking.payment_status %>"><%= booking.payment_status %></span></dd>
          <% if (booking.payment_reference) { %>
            <dt class="col-sm-4">Reference</dt><dd class="col-sm-8"><code><%= booking.payment_reference %></code></dd>
          <% } %>
        </dl>
      </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
      <% if (booking.payment_status !== 'approved') { %>
        <a href="/checkout/<%= booking.booking_id %>" class="btn btn-primary"><%= booking.payment_status === 'declined' ? 'Try payment again' : 'Pay now' %></a>
      <% } %>
      <a href="/bookings" class="btn btn-outline-secondary">Back to bookings</a>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <%- include('partials/footer') %>
</body>
</html>
